# Supabase project URL and keys
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public origin of the dashboard for OAuth callbacks
DASHBOARD_URL=http://localhost:3000
# Origin of the internal Astro preview
NEXT_PUBLIC_LANDING_URL=http://localhost:4321

# GitHub repository_dispatch (server only). Leave the token empty to queue builds without dispatching.
BUILD_REPO=
BUILD_HOOK_TOKEN=
# Shared secret the GitHub Actions job sends to /api/internal/builds (BUILD-2).
BUILD_CALLBACK_TOKEN=

# Set to live when the site API and assigned data are ready.
WORKSPACE_DATA_SOURCE=mock
