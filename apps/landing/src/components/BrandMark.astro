---
/** Logo linkbio: icon mắt xích trên nền gradient olive + hazel. */
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<span class:list={["lb-brand-mark", cls]}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"></path>
    <path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path>
  </svg>
</span>
