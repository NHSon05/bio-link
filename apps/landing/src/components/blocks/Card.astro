---
/** Card dạng hàng: ảnh/icon + tiêu đề + số liệu chữ mảnh hoặc nút ↗. */
import type { Block } from "@bio-link/schema";
import { coverStyle } from "../../lib/icons";
import TLink from "../TLink.astro";
import Round from "../Round.astro";
import Icon from "../Icon.astro";
interface Props {
  b: Block;
  pos: number;
  cls: string;
  attrs: Record<string, string>;
}
const { b, pos, cls, attrs } = Astro.props;
const hot = typeof b.score === "number" && b.score >= 80;
---

<TLink class={["lb-block lb-card-shell lb-card", cls]} href={b.url} track={b.id} pos={pos} {...attrs}>
  {b.thumbnail ? (
    <div class="lb-card-media" style={coverStyle(b.thumbnail, b.id)} />
  ) : (
    <div class="lb-card-media lb-card-ic">
      <Icon name="star" />
    </div>
  )}
  <div class="lb-card-body">
    <div class="lb-card-title">
      {b.text}
      {hot && <span class="lb-hot">Hot</span>}
    </div>
    {b.subtext && <div class="lb-card-sub">{b.subtext}</div>}
  </div>
  {b.metric ? (
    <div class="lb-metric">
      {String(b.metric)}
      {b.unit && <small>{String(b.unit)}</small>}
    </div>
  ) : (
    <Round name="arrow-ur" />
  )}
</TLink>
