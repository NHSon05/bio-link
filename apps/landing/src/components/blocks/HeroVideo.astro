---
import type { Block } from "@bio-link/schema";
import { coverStyle } from "../../lib/icons";
import TLink from "../TLink.astro";
import Round from "../Round.astro";
interface Props { b: Block; pos: number; cls: string; attrs: Record<string, string> }
const { b, pos, cls, attrs } = Astro.props;
---
<TLink class={["lb-block lb-card-shell lb-hero", cls]} href={b.url} track={b.id} pos={pos} {...attrs}>
  <div class="lb-hero-media" style={coverStyle(b.thumbnail, b.id + "hero")}>
    <Round name="triangle" class="lb-play" />
    {b.badge && <span class="lb-chip lb-badge">{String(b.badge)}</span>}
  </div>
  {b.text && <div class="lb-hero-foot"><div class="lb-hero-text">{b.text}</div><Round name="arrow-ur" /></div>}
</TLink>
