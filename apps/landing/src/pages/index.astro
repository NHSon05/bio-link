---
/** Trang gốc: hub nội bộ để dev xem nhanh các slug. Production có thể redirect hoặc bỏ. */
import SiteHub from "../components/hub/SiteHub";
import { loadBuildSites } from "../lib/data";
import "../styles/ui.css";

const sites = (await loadBuildSites()).map((site) => ({
  slug: site.slug,
  title: site.profile.title,
  template: site.template,
  platform: site.source?.platform,
}));
const dashboardUrl = import.meta.env.PUBLIC_DASHBOARD_URL ?? "http://localhost:3000";
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>bio-link landing</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&display=swap" />
  </head>
  <body>
    <SiteHub sites={sites} dashboardUrl={dashboardUrl} />
  </body>
</html>
